# ============================================================
#  .env.example — qué variables necesita este repo y de dónde salen
# ============================================================
#  Copiar a `.env.local` (que es la que leen `neon dev` y
#  `neon deploy --env .env.local`) y rellenar. `.env.local` está
#  gitignoreada; nunca versionar ninguna de estas respuestas.
#
#  Hay dos grupos y NO son intercambiables:
#    · VITE_*  → se hornean en el bundle en `npm run build`. Las ve quien abra
#      las DevTools. Son públicas por diseño (la URL de una Function no es un
#      secreto), y por eso `functions/` no lee ninguna de este grupo.
#    · las demás → solo viven en el despliegue de Neon, inyectadas por el
#      bloque `env` de neon.ts. Si una de estas se filtra al bundle, hay que
#      rotarla: `BLINK_DATA_JWT_SECRET` firma el token que autoriza consultas
#      a la base de datos.
#  `neon env pull` escribe las de Neon (DATABASE_URL*, NEON_*) y deja las
#  nuestras intactas; por eso `.env.local` es la mezcla de ambos grupos.

# ------------------------------------------------------------
# 1) Build del front — tres URLs públicas
# ------------------------------------------------------------
#  Cada una es el campo `invocation_url` de su Function:
#      neon functions get auth    | grep invocation_url
#      neon functions get datos   | grep invocation_url
#      neon functions get tasabcv | grep invocation_url
#  Con las tres vacías el front arranca pero no puede ni loguear
#  (src/lib/entorno.ts, `entornoListo()`).
VITE_BLINK_AUTH_URL=https://<branch_id>-auth.compute.<cell>.us-east-2.aws.neon.tech
VITE_BLINK_DATOS_URL=https://<branch_id>-datos.compute.<cell>.us-east-2.aws.neon.tech
VITE_BLINK_TASA_URL=https://<branch_id>-tasabcv.compute.<cell>.us-east-2.aws.neon.tech

# ------------------------------------------------------------
# 2) Functions — secretos (los declara neon.ts, required: true)
# ------------------------------------------------------------
#  Firma las sesiones de Better Auth. openssl rand -hex 32
BETTER_AUTH_SECRET=

#  Firma el JWT de datos de 15 minutos que emite `auth` y verifica `datos`.
#  Distinto a BETTER_AUTH_SECRET a propósito: un secreto que firma el login y
#  además autoriza consultas es un único punto de fallo para dos cosas.
#  openssl rand -hex 32  (mínimo 32 caracteres o la Function no arranca)
BLINK_DATA_JWT_SECRET=

#  URL pública de ESTA Function `auth`. Better Auth compara el Origin de cada
#  request contra ella, así que un valor aproximado da 403 en el login. Sin
#  esta variable el config cae en http://localhost:4000 y solo sirve local.
BETTER_AUTH_URL=https://<branch_id>-auth.compute.<cell>.us-east-2.aws.neon.tech

#  Orígenes permitidos, separados por coma. Tiene que estar aquí DOS veces
#  por dos mecanismos distintos de Better Auth (medido en 1.7.19):
#    · `cors.origin`       → pinta las cabeceras de la respuesta.
#    · `trustedOrigins`    → es la que rechaza el request con 403
#      INVALID_ORIGIN cuando el navegador manda cabecera Origin.
#  Poner el origen del front (plans.blink.com.ve) y, para local, 5173.
BLINK_ALLOWED_ORIGINS=https://plans.blink.com.ve,http://localhost:5173

# ------------------------------------------------------------
# 3) Lo inyecta Neon solo — NO escribir a mano
# ------------------------------------------------------------
#  DATABASE_URL / DATABASE_URL_UNPOOLED / NEON_BRANCH / NEON_BRANCH_ID /
#  NEON_FUNCTION_HOST_SUFFIX. Las aporta `neon env pull`, `neon dev` o el
#  propio runtime de la Function según la rama, y la cadena de conexión
#  nunca puede aparecer en el bundle.
